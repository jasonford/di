#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BROOT_BIN="${BROOT_BIN:-broot}"
TMUX_CONFIG="${TMUX_CONFIG:-$SCRIPT_ROOT/.tmux/tmux.conf}"
TMUX_SESSION_NAME="broot-editor-state-smoke-$$"
tmux_cmd=(tmux -u -f "$TMUX_CONFIG")

tmp_dir="$(mktemp -d /tmp/broot-editor-state.XXXXXX)"
repo_root="$tmp_dir/repo"
selection_output="$tmp_dir/selection.txt"
editor_state_file="$tmp_dir/editor-state.tsv"
home_dir="$tmp_dir/home"
xdg_config_home="$tmp_dir/xdg-config"
last_capture=""
modified_yellow_fg_regex=$'\033\\[[0-9;]*(33|93|38;5;11)m'

cleanup() {
  "${tmux_cmd[@]}" kill-session -t "$TMUX_SESSION_NAME" >/dev/null 2>&1 || true
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

require_executable() {
  if [[ "$1" == */* ]]; then
    [ -x "$1" ] || {
      printf 'missing required executable: %s\n' "$1" >&2
      exit 1
    }
  else
    require_command "$1"
  fi
}

capture_pane() {
  last_capture="$("${tmux_cmd[@]}" capture-pane -p -t "$TMUX_SESSION_NAME:0.0" -S -200 2>/dev/null || true)"
}

capture_pane_escaped() {
  last_capture="$("${tmux_cmd[@]}" capture-pane -e -p -t "$TMUX_SESSION_NAME:0.0" -S -200 2>/dev/null || true)"
}

assert_no_trailing_stats() {
  local file_regex="$1"

  capture_pane
  if printf '%s\n' "$last_capture" | grep -Eq "${file_regex}[[:space:]]+\\+[0-9]+(-[0-9]+)?$"; then
    fail_with_capture "git stats still trailed ${file_regex}"
  fi
}

file_name_column() {
  local file_name="$1"

  printf '%s\n' "$last_capture" | awk -v needle="$file_name" '
    index($0, needle) {
      print index($0, needle)
      exit
    }
  '
}

pane_dead() {
  "${tmux_cmd[@]}" display-message -p -t "$TMUX_SESSION_NAME:0.0" '#{pane_dead}' 2>/dev/null || printf '1\n'
}

wait_for_regex() {
  local expected_regex="$1"
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    capture_pane
    if printf '%s\n' "$last_capture" | grep -Eq "$expected_regex"; then
      return 0
    fi
    if [ "$(pane_dead)" = "1" ]; then
      return 1
    fi
    sleep 0.1
  done
  capture_pane
  printf '%s\n' "$last_capture" | grep -Eq "$expected_regex"
}

wait_for_regex_escaped() {
  local expected_regex="$1"
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    capture_pane_escaped
    if printf '%s\n' "$last_capture" | grep -Eq "$expected_regex"; then
      return 0
    fi
    if [ "$(pane_dead)" = "1" ]; then
      return 1
    fi
    sleep 0.1
  done
  capture_pane_escaped
  printf '%s\n' "$last_capture" | grep -Eq "$expected_regex"
}

wait_for_absent_regex() {
  local expected_regex="$1"
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    capture_pane
    if ! printf '%s\n' "$last_capture" | grep -Eq "$expected_regex"; then
      return 0
    fi
    if [ "$(pane_dead)" = "1" ]; then
      return 1
    fi
    sleep 0.1
  done
  capture_pane
  ! printf '%s\n' "$last_capture" | grep -Eq "$expected_regex"
}

wait_for_literal() {
  local expected_literal="$1"
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    capture_pane
    if printf '%s\n' "$last_capture" | grep -Fq "$expected_literal"; then
      return 0
    fi
    if [ "$(pane_dead)" = "1" ]; then
      return 1
    fi
    sleep 0.1
  done
  capture_pane
  printf '%s\n' "$last_capture" | grep -Fq "$expected_literal"
}

fail_with_capture() {
  local message="$1"
  capture_pane
  printf '%s\n' "$message" >&2
  printf '%s\n' "$last_capture" >&2
  exit 1
}

fail_with_capture_escaped() {
  local message="$1"
  capture_pane_escaped
  printf '%s\n' "$message" >&2
  printf '%s\n' "$last_capture" >&2
  exit 1
}

assert_aligned_name_columns() {
  local left_name="$1"
  local right_name="$2"
  local left_column=""
  local right_column=""

  capture_pane
  left_column="$(file_name_column "$left_name")"
  right_column="$(file_name_column "$right_name")"
  if [ -z "$left_column" ] || [ -z "$right_column" ] || [ "$left_column" != "$right_column" ]; then
    printf 'expected aligned name columns for %s and %s\n' "$left_name" "$right_name" >&2
    printf 'left column: %s\n' "${left_column:-<missing>}" >&2
    printf 'right column: %s\n' "${right_column:-<missing>}" >&2
    fail_with_capture 'context gutter width shifted the filename column'
  fi
}

launch_tmux() {
  mkdir -p "$repo_root" "$home_dir" "$xdg_config_home"
  mkdir -p "$repo_root/folder" "$repo_root/stats-folder"
  printf 'alpha\n' >"$repo_root/alpha.txt"
  printf 'beta\n' >"$repo_root/beta.txt"
  printf 'nested\n' >"$repo_root/folder/nested.txt"
  printf 'seed\n' >"$repo_root/stats-folder/seed.txt"
  git -C "$repo_root" init -q
  git -C "$repo_root" add alpha.txt beta.txt folder/nested.txt stats-folder/seed.txt
  git -C "$repo_root" -c user.name=Test -c user.email=test@example.com commit -qm init
  printf 'alpha\ndirty\n' >"$repo_root/alpha.txt"
  : >"$selection_output"
  : >"$editor_state_file"

  "${tmux_cmd[@]}" new-session -d -s "$TMUX_SESSION_NAME" -x 120 -y 20 \
    "TERM=tmux-256color HOME=$home_dir BR_INSTALL=no XDG_CONFIG_HOME=$xdg_config_home $BROOT_BIN --selection-output $selection_output --editor-state-file $editor_state_file -g --confine-root $repo_root --cmd :toggle_watch"
}

require_command git
require_command grep
require_command realpath
require_command tmux
require_executable "$BROOT_BIN"

launch_tmux

if ! wait_for_regex 'alpha\.txt'; then
  fail_with_capture 'broot never rendered the tracked file list'
fi
if ! wait_for_regex 'folder$'; then
  fail_with_capture 'broot never rendered the tracked directory row'
fi
if ! wait_for_literal '+1-0├──alpha.txt'; then
  fail_with_capture 'git diff stats never moved into the alpha.txt gutter'
fi
assert_aligned_name_columns 'folder' 'alpha.txt'
assert_aligned_name_columns 'alpha.txt' 'beta.txt'
assert_no_trailing_stats 'alpha\.txt'
assert_no_trailing_stats 'beta\.txt'

for idx in $(seq -w 1 50); do
  printf 'fresh\n' >"$repo_root/stats-folder/file-$idx.txt"
done
if ! wait_for_regex '\+[0-9]+(-[0-9]+)?[[:space:]]+[├└]──[0-9]+ unlisted$'; then
  fail_with_capture 'broot never rendered a pruning row with git stats for a partially visible directory'
fi
if ! wait_for_regex 'stats-folder$'; then
  fail_with_capture 'broot never kept the stats-folder row visible while pruning hidden children'
fi
if ! wait_for_absent_regex '^[[:space:]]*\+[0-9]+(-[0-9]+)?[[:space:]]+[├└]──stats-folder$'; then
  fail_with_capture 'directory row still duplicated git stats while a pruning row was visible'
fi
assert_aligned_name_columns 'stats-folder' 'alpha.txt'

rm -f "$repo_root"/stats-folder/file-*.txt
if ! wait_for_absent_regex '[0-9]+ unlisted$'; then
  fail_with_capture 'pruning row did not clear after removing transient files from stats-folder'
fi

printf 'fresh\n' >"$repo_root/untracked.txt"
if ! wait_for_regex '\+1[[:space:]]+[├└]──untracked\.txt$'; then
  fail_with_capture 'new files should render insertion-only stats in the gutter'
fi
assert_aligned_name_columns 'alpha.txt' 'untracked.txt'
assert_no_trailing_stats 'untracked\.txt'

printf '0\t%s\n' "$repo_root/alpha.txt" >"$editor_state_file"
sleep 0.2
if ! wait_for_absent_regex '[=*].*alpha\.txt$'; then
  fail_with_capture 'clean editor state should no longer print a gutter marker'
fi
if ! wait_for_literal '+1-0├──alpha.txt'; then
  fail_with_capture 'clean editor state shifted the alpha.txt gutter layout'
fi
assert_aligned_name_columns 'folder' 'alpha.txt'
assert_aligned_name_columns 'alpha.txt' 'beta.txt'
assert_no_trailing_stats 'alpha\.txt'

printf '1\t%s\n' "$repo_root/alpha.txt" >"$editor_state_file"
sleep 0.2
if ! wait_for_absent_regex '[=*].*alpha\.txt$'; then
  fail_with_capture 'modified editor state should no longer print a gutter marker'
fi
if ! wait_for_literal '+1-0├─•alpha.txt'; then
  fail_with_capture 'modified editor state did not replace the final branch segment with a bullet'
fi
if ! wait_for_regex_escaped "${modified_yellow_fg_regex}•"; then
  fail_with_capture_escaped 'modified editor state bullet was not yellow'
fi
assert_aligned_name_columns 'folder' 'alpha.txt'
assert_aligned_name_columns 'alpha.txt' 'beta.txt'
assert_no_trailing_stats 'alpha\.txt'

: >"$editor_state_file"
if ! wait_for_absent_regex '[=*].*alpha\.txt$'; then
  fail_with_capture 'editor marker did not clear when the state file was emptied'
fi
if ! wait_for_literal '+1-0├──alpha.txt'; then
  fail_with_capture 'alpha.txt gutter did not return to git-only state'
fi
assert_aligned_name_columns 'folder' 'alpha.txt'
assert_aligned_name_columns 'alpha.txt' 'beta.txt'
assert_no_trailing_stats 'alpha\.txt'

for idx in $(seq -w 1 30); do
  printf 'filler\n' >"$repo_root/zz-root-$idx.txt"
done

if ! wait_for_regex 'folder …$'; then
  fail_with_capture 'folder never rendered as a collapsed directory row'
fi
if ! wait_for_absent_regex 'nested\.txt$'; then
  fail_with_capture 'folder never hid its nested child after the root filled up'
fi

printf 'nested\ndirty\n' >"$repo_root/folder/nested.txt"
if ! wait_for_regex '\+1-0[[:space:]]+[├└]──folder …$'; then
  fail_with_capture 'collapsed directory did not roll up git diff stats from hidden descendants'
fi
assert_aligned_name_columns 'alpha.txt' 'folder'
assert_no_trailing_stats 'folder'

printf '1\t%s\n' "$repo_root/folder/nested.txt" >"$editor_state_file"
sleep 0.2
if ! wait_for_regex '\+1-0[[:space:]]+[├└]─•folder …$'; then
  fail_with_capture 'collapsed directory did not show a bullet for hidden unsaved edits'
fi
if ! wait_for_regex_escaped "${modified_yellow_fg_regex}•\033\\[[0-9;]*mfolder …"; then
  fail_with_capture_escaped 'collapsed directory hidden editor state bullet was not yellow'
fi

: >"$editor_state_file"
if ! wait_for_regex '\+1-0[[:space:]]+[├└]──folder …$'; then
  fail_with_capture 'collapsed directory editor marker did not clear when the state file was emptied'
fi

for idx in $(seq -w 1 30); do
  mkdir -p "$repo_root/pruned-$idx"
  printf 'nested\n' >"$repo_root/pruned-$idx/nested.txt"
done

if ! wait_for_regex '[0-9]+ unlisted$'; then
  fail_with_capture 'broot never rendered a pruning row after adding many directories'
fi

printf '1\t%s\n' "$repo_root/pruned-30/nested.txt" >"$editor_state_file"
sleep 0.2
if ! wait_for_regex '•[0-9]+ unlisted$'; then
  fail_with_capture 'modified hidden editor state did not propagate to the pruning row'
fi
if ! wait_for_regex_escaped "${modified_yellow_fg_regex}•\033\\[[0-9;]*m[0-9]+ unlisted"; then
  fail_with_capture_escaped 'modified hidden editor state bullet was not yellow'
fi

: >"$editor_state_file"
if ! wait_for_absent_regex '•[0-9]+ unlisted$'; then
  fail_with_capture 'pruning row editor marker did not clear when the state file was emptied'
fi

printf 'broot editor state smoke test passed\n'

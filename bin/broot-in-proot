#!/usr/bin/env bash
set -euo pipefail

workdir="${WORKDIR:-/workspace}"
if [ "$#" -gt 0 ] && [ -d "$1" ]; then
  workdir="$1"
  shift
fi

workdir="$(cd "$workdir" && pwd -P)"

if [ ! -d "$workdir" ]; then
  printf 'isolated broot error: missing workdir %s\n' "$workdir" >&2
  exit 1
fi

if [ ! -x /usr/bin/proot ]; then
  printf 'isolated broot error: proot is not installed\n' >&2
  exit 1
fi

runtime_dir="$(mktemp -d /tmp/codex-broot-proot.XXXXXX)"
cleanup() {
  rm -rf "$runtime_dir"
}
trap cleanup EXIT

mkdir -p "$runtime_dir/conf" "$runtime_dir/rootfs" "$runtime_dir/xdg-config"

cat >"$runtime_dir/conf/conf.hjson" <<'EOF'
{
    special_paths: {
        "/bin": { show: "never", list: "never", sum: "never" },
        "/dev": { show: "never", list: "never", sum: "never" },
        "/etc": { show: "never", list: "never", sum: "never" },
        "/home": { show: "never", list: "never", sum: "never" },
        "/lib": { show: "never", list: "never", sum: "never" },
        "/lib64": { show: "never", list: "never", sum: "never" },
        "/media": { show: "never", list: "never", sum: "never" },
        "/mnt": { show: "never", list: "never", sum: "never" },
        "/opt": { show: "never", list: "never", sum: "never" },
        "/proc": { show: "never", list: "never", sum: "never" },
        "/root": { show: "never", list: "never", sum: "never" },
        "/run": { show: "never", list: "never", sum: "never" },
        "/srv": { show: "never", list: "never", sum: "never" },
        "/sys": { show: "never", list: "never", sum: "never" },
        "/tmp": { show: "never", list: "never", sum: "never" },
        "/usr": { show: "never", list: "never", sum: "never" },
        "/var": { show: "never", list: "never", sum: "never" }
    }
}
EOF

proot_args=(
  /usr/bin/proot
  -r "$runtime_dir/rootfs"
  -w /workspace
  -b "$workdir:/workspace"
  -b /usr/local/bin/broot:/usr/local/bin/broot
  -b /lib:/lib
  -b /lib64:/lib64
  -b /usr/lib:/usr/lib
  -b /tmp:/tmp
  -b /dev:/dev
  -b /proc:/proc
)

if [ -d /etc/alternatives ]; then
  proot_args+=(-b /etc/alternatives:/etc/alternatives)
fi

if [ -d /etc/terminfo ]; then
  proot_args+=(-b /etc/terminfo:/etc/terminfo)
fi

if [ -d /lib/terminfo ]; then
  proot_args+=(-b /lib/terminfo:/lib/terminfo)
fi

if [ -d /usr/share/misc ]; then
  proot_args+=(-b /usr/share/misc:/usr/share/misc)
fi

if [ -d /usr/share/terminfo ]; then
  proot_args+=(-b /usr/share/terminfo:/usr/share/terminfo)
fi

broot_args=("$@")
if [ "${#broot_args[@]}" -eq 0 ]; then
  broot_args=(/workspace)
fi

exec env \
  BR_INSTALL=no \
  XDG_CONFIG_HOME="$runtime_dir/xdg-config" \
  PATH='/usr/local/bin:/usr/bin:/bin' \
  "${proot_args[@]}" \
  /usr/local/bin/broot \
  --conf "$runtime_dir/conf/conf.hjson" \
  "${broot_args[@]}"

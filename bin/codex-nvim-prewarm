#!/usr/bin/env bash
set -euo pipefail

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
session_name="${1:-${CODEX_TMUX_SESSION:-}}"

if [ -z "$session_name" ]; then
  if [ -n "${TMUX_PANE:-}" ]; then
    session_name="$(tmux display-message -p -t "$TMUX_PANE" '#S')"
  else
    printf 'codex-nvim-prewarm needs a tmux session\n' >&2
    exit 1
  fi
fi

tmux_option() {
  tmux show-options -qv -t "$session_name" "$1"
}

workspace_dir="$(tmux_option @broot_workspace_dir)"
runtime_dir="$(tmux_option @broot_runtime_dir)"

if [ -z "$workspace_dir" ] || [ -z "$runtime_dir" ]; then
  exit 0
fi

repo_nvim_config="$workspace_dir/config/nvim"
repo_lazy_config="$repo_nvim_config/lua/config/lazy.lua"
if [ ! -f "$repo_nvim_config/init.lua" ] || [ ! -f "$repo_lazy_config" ]; then
  exit 0
fi

export HOME="$runtime_dir/home"
export XDG_CONFIG_HOME="$runtime_dir/xdg-config"
export XDG_CACHE_HOME="$runtime_dir/xdg-cache"
export XDG_DATA_HOME="$runtime_dir/xdg-data"
export XDG_STATE_HOME="$runtime_dir/xdg-state"

mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"
rm -rf "$XDG_CONFIG_HOME/nvim"
ln -s "$repo_nvim_config" "$XDG_CONFIG_HOME/nvim"

ready_stamp="$runtime_dir/nvim-prewarm-ready"
lock_dir="$runtime_dir/nvim-prewarm-lock"
log_file="$runtime_dir/nvim-prewarm.log"

needs_prewarm() {
  [ ! -f "$ready_stamp" ] && return 0
  find "$repo_nvim_config" -type f -newer "$ready_stamp" -print -quit | grep -q .
}

if ! needs_prewarm; then
  exit 0
fi

acquire_lock() {
  while true; do
    if mkdir "$lock_dir" 2>/dev/null; then
      printf '%s\n' "$$" >"$lock_dir/pid"
      return 0
    fi

    if [ -f "$ready_stamp" ] && ! needs_prewarm; then
      return 1
    fi

    lock_pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      sleep 0.1
      continue
    fi

    rm -rf "$lock_dir" >/dev/null 2>&1 || sleep 0.1
  done
}

if ! acquire_lock; then
  exit 0
fi

cleanup() {
  rm -rf "$lock_dir" >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM

if ! needs_prewarm; then
  exit 0
fi

{
  printf '==> %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  printf 'workspace=%s\n' "$workspace_dir"
} >>"$log_file"

cd "$workspace_dir"
lockfile_path="$repo_nvim_config/lazy-lock.json"
lazy_cmds=()
if [ -f "$lockfile_path" ]; then
  lazy_cmds+=("+Lazy! restore")
fi
lazy_cmds+=("+Lazy! install" "+qa")

rm -f "$ready_stamp"
if nvim --headless "${lazy_cmds[@]}" >>"$log_file" 2>&1; then
  touch "$ready_stamp"
  exit 0
fi

exit 1

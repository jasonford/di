#!/usr/bin/env bash
set -euo pipefail

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
session_name="${CODEX_TMUX_SESSION:-}"

if [ -z "$session_name" ]; then
  if [ -n "${TMUX_PANE:-}" ]; then
    session_name="$(tmux display-message -p -t "$TMUX_PANE" '#S')"
  else
    printf 'codex-nvim-pane needs a tmux session\n' >&2
    exit 1
  fi
fi

tmux_option() {
  tmux show-options -qv -t "$session_name" "$1"
}

workspace_dir="$(tmux_option @broot_workspace_dir)"
runtime_dir="$(tmux_option @broot_runtime_dir)"
socket_path="$(tmux_option @codex_nvim_socket)"
state_file="$(tmux_option @codex_nvim_state_file)"
broot_pane="$(tmux_option @broot_pane_id)"
pane_id="${TMUX_PANE:-}"
initial_path="${CODEX_NVIM_INITIAL_PATH:-}"

export HOME="$runtime_dir/home"
export XDG_CONFIG_HOME="$runtime_dir/xdg-config"
export XDG_CACHE_HOME="$runtime_dir/xdg-cache"
export XDG_DATA_HOME="$runtime_dir/xdg-data"
export XDG_STATE_HOME="$runtime_dir/xdg-state"
export CODEX_NVIM_BOOTSTRAP="$script_root/bin/codex-nvim-bootstrap.lua"
export CODEX_NVIM_STATE_FILE="$state_file"

cleanup_done=0
cleanup() {
  if [ "$cleanup_done" -eq 1 ]; then
    return
  fi
  cleanup_done=1

  current_pane="$(tmux show-options -qv -t "$session_name" @codex_nvim_pane_id)"
  if [ -n "$pane_id" ] && [ "$current_pane" = "$pane_id" ]; then
    rm -f "$socket_path"
    : >"$state_file"
    tmux set-option -qu -t "$session_name" @codex_nvim_pane_id
    "$script_root/bin/codex-layout" two-column "$session_name" >/dev/null 2>&1 || true
    if [ -n "$broot_pane" ]; then
      tmux select-pane -t "$broot_pane" >/dev/null 2>&1 || true
    fi
  fi
  if [ -n "$pane_id" ]; then
    tmux kill-pane -t "$pane_id" >/dev/null 2>&1 || true
  fi
}

trap cleanup EXIT HUP INT TERM

mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"
repo_nvim_config="$workspace_dir/config/nvim"
if [ -d "$repo_nvim_config" ]; then
  rm -rf "$XDG_CONFIG_HOME/nvim"
  ln -s "$repo_nvim_config" "$XDG_CONFIG_HOME/nvim"
fi
mkdir -p "$(dirname "$state_file")"
: >"$state_file"
rm -f "$socket_path"

cd "$workspace_dir"
if ! "$script_root/bin/codex-nvim-prewarm" "$session_name"; then
  tmux display-message -d 5000 "Neovim plugin setup failed; see $runtime_dir/nvim-prewarm.log"
fi
nvim --listen "$socket_path" \
  --cmd "set hidden" \
  --cmd "lua dofile(vim.env.CODEX_NVIM_BOOTSTRAP)" \
  "$initial_path"

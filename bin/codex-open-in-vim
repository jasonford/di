#!/usr/bin/env bash
set -euo pipefail

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -z "${TMUX_PANE:-}" ]; then
  printf 'codex-open-in-vim must run inside tmux\n' >&2
  exit 1
fi

open_mode="open"
if [ "${1:-}" = "--preview" ]; then
  open_mode="preview"
  shift
fi

session_name="$(tmux display-message -p -t "$TMUX_PANE" '#S')"

tmux_option() {
  tmux show-options -qv -t "$session_name" "$1"
}

pane_live() {
  local pane_id="$1"
  [ -n "$pane_id" ] || return 1
  [ "$(tmux display-message -p -t "$pane_id" '#{pane_dead}' 2>/dev/null || printf '1')" = "0" ]
}

clamp_width() {
  local desired="$1"
  local maximum="$2"

  if [ "$maximum" -lt 1 ]; then
    printf '1\n'
    return 0
  fi
  if [ "$desired" -gt "$maximum" ]; then
    printf '%s\n' "$maximum"
    return 0
  fi
  printf '%s\n' "$desired"
}

socket_live() {
  local socket_path="$1"
  [ -n "$socket_path" ] || return 1
  [ -S "$socket_path" ] || return 1
  nvim --server "$socket_path" --remote-expr '1' </dev/null >/dev/null 2>&1
}

set_pending_open() {
  local path="$1"
  local mode="$2"
  local current_mode

  current_mode="$(tmux_option @codex_nvim_pending_mode)"
  if [ "$mode" = "preview" ] && [ "$current_mode" = "open" ]; then
    return 0
  fi

  tmux set-option -t "$session_name" @codex_nvim_pending_path "$path"
  tmux set-option -t "$session_name" @codex_nvim_pending_mode "$mode"
}

clear_pending_open() {
  tmux set-option -qu -t "$session_name" @codex_nvim_pending_path
  tmux set-option -qu -t "$session_name" @codex_nvim_pending_mode
}

selection_file="$(tmux_option @broot_selection_output)"
workspace_dir="$(tmux_option @broot_workspace_dir)"
socket_path="$(tmux_option @codex_nvim_socket)"
state_file="$(tmux_option @codex_nvim_state_file)"
nvim_pane="$(tmux_option @codex_nvim_pane_id)"
codex_pane="$(tmux_option @codex_pane_id)"
broot_pane="$(tmux_option @broot_pane_id)"
window_id="$(tmux_option @codex_window_id)"

selected_path="${1:-}"
if [ -z "$selected_path" ] && [ -n "$selection_file" ] && [ -f "$selection_file" ]; then
  IFS= read -r selected_path <"$selection_file" || true
fi

if [ -z "$selected_path" ]; then
  exit 0
fi

case "$selected_path" in
  /*) ;;
  *)
    selected_path="$(realpath -m -- "$workspace_dir/$selected_path")"
    ;;
esac

if pane_live "$nvim_pane" && socket_live "$socket_path"; then
  clear_pending_open
  selected_path_vimscript="${selected_path//\'/\'\'}"
  if [ "$open_mode" = "preview" ]; then
    remote_expr="luaeval('CodexManagedPreview(_A)', '$selected_path_vimscript')"
  else
    remote_expr="luaeval('CodexManagedOpen(_A)', '$selected_path_vimscript')"
  fi
  nvim --server "$socket_path" --remote-expr "$remote_expr" </dev/null >/dev/null 2>&1
  "$script_root/bin/codex-layout" three-column "$session_name"
  if [ "$open_mode" = "open" ]; then
    tmux select-pane -t "$nvim_pane"
  fi
  exit 0
fi

if pane_live "$nvim_pane"; then
  set_pending_open "$selected_path" "$open_mode"
  exit 0
fi

if [ -n "$state_file" ]; then
  : >"$state_file"
fi
rm -f "$socket_path"
clear_pending_open
tmux set-option -qu -t "$session_name" @codex_nvim_pane_id
if pane_live "$nvim_pane"; then
  tmux kill-pane -t "$nvim_pane" >/dev/null 2>&1 || true
fi

window_target="${window_id:-$codex_pane}"
layout_target="$broot_pane"
if ! pane_live "$layout_target"; then
  layout_target="$window_target"
fi
window_width="$(tmux display-message -p -t "$window_target" '#{window_width}')"
fixed_side_width=48
side_width="$(clamp_width "$fixed_side_width" "$(( (window_width - 3) / 2 ))")"
middle_width="$(( window_width - side_width - side_width - 2 ))"
nvim_pane="$(
  tmux split-window -d -h -l "$middle_width" -P -F '#{pane_id}' \
    -t "$layout_target" \
    -c "$workspace_dir" \
    -e CODEX_NVIM_INITIAL_PATH="$selected_path" \
    -e CODEX_NVIM_INITIAL_MODE="$open_mode" \
    -e CODEX_TMUX_SESSION="$session_name" \
    "bash \"$script_root/bin/codex-nvim-pane\""
)"
tmux set-option -t "$session_name" @codex_nvim_pane_id "$nvim_pane"
if pane_live "$broot_pane"; then
  tmux resize-pane -t "$broot_pane" -x "$side_width" >/dev/null 2>&1 || true
fi
if pane_live "$codex_pane"; then
  tmux resize-pane -t "$codex_pane" -x "$side_width" >/dev/null 2>&1 || true
fi
set_pending_open "$selected_path" "$open_mode"
printf -v focus_cmd 'bash %q %q %q %q' \
  "$script_root/bin/codex-nvim-focus-when-ready" \
  "$session_name" \
  "$nvim_pane" \
  "$socket_path"
tmux run-shell -b "$focus_cmd"

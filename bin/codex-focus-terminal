#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -z "${TMUX_PANE:-}" ]; then
  printf 'codex-focus-terminal must run inside tmux\n' >&2
  exit 1
fi

session_name="$(tmux display-message -p -t "$TMUX_PANE" '#S')"

tmux_option() {
  tmux show-options -qv -t "$session_name" "$1" 2>/dev/null || true
}

normalize_path() {
  local path="$1"
  [ -n "$path" ] || return 0
  realpath -m -- "$path" 2>/dev/null || printf '%s\n' "$path"
}

pane_live() {
  local pane_id="$1"
  [ -n "$pane_id" ] || return 1
  [ "$(tmux display-message -p -t "$pane_id" '#{pane_dead}' 2>/dev/null || printf '1')" = "0" ]
}

read_selection_dir() {
  local selection_output="$1"
  local workspace_dir="$2"
  local selected_path=""

  [ -n "$selection_output" ] || return 0
  [ -f "$selection_output" ] || return 0

  IFS= read -r selected_path < "$selection_output" || true
  [ -n "$selected_path" ] || return 0

  if [[ "$selected_path" != /* ]]; then
    selected_path="${workspace_dir:-.}/$selected_path"
  fi

  if [ -d "$selected_path" ]; then
    normalize_path "$selected_path"
    return 0
  fi

  if [ -e "$selected_path" ]; then
    normalize_path "$(dirname -- "$selected_path")"
  fi
}

workspace_dir="$(tmux_option @broot_workspace_dir)"
selection_output="$(tmux_option @broot_selection_output)"
terminal_pane="$(tmux_option @codex_terminal_pane_id)"
terminal_dir="$(tmux_option @codex_terminal_dir)"
selected_dir="$(read_selection_dir "$selection_output" "$workspace_dir")"

[ -n "$terminal_pane" ] || exit 0

if [ -n "$selected_dir" ]; then
  terminal_dir="$selected_dir"
  tmux set-option -q -t "$session_name" @codex_terminal_dir "$terminal_dir" >/dev/null 2>&1 || true
fi

if ! pane_live "$terminal_pane"; then
  tmux respawn-pane -k -t "$terminal_pane" -c "${terminal_dir:-${workspace_dir:-.}}" "$SCRIPT_ROOT/bin/codex-terminal-shell" >/dev/null 2>&1 || exit 0
fi

tmux select-pane -t "$terminal_pane" >/dev/null 2>&1 || true

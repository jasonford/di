#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -z "${TMUX_PANE:-}" ]; then
  printf 'codex-focus-terminal must run inside tmux\n' >&2
  exit 1
fi

session_name="$(tmux display-message -p -t "$TMUX_PANE" '#S')"

tmux_option() {
  tmux show-options -qv -t "$session_name" "$1" 2>/dev/null || true
}

clear_prefill_options() {
  tmux set-option -q -t "$session_name" @codex_terminal_prefilled_selection "" >/dev/null 2>&1 || true
  tmux set-option -q -t "$session_name" @codex_terminal_prefilled_command "" >/dev/null 2>&1 || true
}

set_activated_selection() {
  tmux set-option -q -t "$session_name" @codex_terminal_activated_selection "$1" >/dev/null 2>&1 || true
}

normalize_path() {
  local path="$1"
  [ -n "$path" ] || return 0
  realpath -m -- "$path" 2>/dev/null || printf '%s\n' "$path"
}

pane_live() {
  local pane_id="$1"
  [ -n "$pane_id" ] || return 1
  [ "$(tmux display-message -p -t "$pane_id" '#{pane_dead}' 2>/dev/null || printf '1')" = "0" ]
}

pane_command() {
  local pane_id="$1"
  [ -n "$pane_id" ] || return 0
  tmux display-message -p -t "$pane_id" '#{pane_current_command}' 2>/dev/null || true
}

pane_path() {
  local pane_id="$1"
  local current_path=""

  [ -n "$pane_id" ] || return 0
  current_path="$(tmux display-message -p -t "$pane_id" '#{pane_current_path}' 2>/dev/null || true)"
  normalize_path "$current_path"
}

pane_contains_text() {
  local pane_id="$1"
  local expected="$2"
  local capture=""

  [ -n "$pane_id" ] || return 1
  [ -n "$expected" ] || return 1

  capture="$(tmux capture-pane -p -t "$pane_id" -S -1 2>/dev/null || true)"
  printf '%s' "$capture" | grep -Fq "$expected"
}

is_shell_command() {
  case "$1" in
    bash|sh|zsh|fish)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_vim_command() {
  case "$1" in
    nvim|vim|vi|view|vimdiff)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

read_selection_path() {
  local selection_output="$1"
  local workspace_dir="$2"
  local selected_path=""

  [ -n "$selection_output" ] || return 0
  [ -f "$selection_output" ] || return 0

  IFS= read -r selected_path < "$selection_output" || true
  [ -n "$selected_path" ] || return 0

  if [[ "$selected_path" != /* ]]; then
    selected_path="${workspace_dir:-.}/$selected_path"
  fi

  normalize_path "$selected_path"
}

selection_target_dir() {
  local selection_path="$1"

  [ -n "$selection_path" ] || return 0

  if [ -d "$selection_path" ]; then
    printf '%s\n' "$selection_path"
    return 0
  fi

  if [ -e "$selection_path" ]; then
    normalize_path "$(dirname -- "$selection_path")"
  fi
}

vim_single_quote_escape() {
  printf "%s" "$1" | sed "s/'/''/g"
}

relative_open_path() {
  local current_dir="$1"
  local target_path="$2"
  local relative_path=""

  if [ -n "$current_dir" ] && [ -n "$target_path" ]; then
    relative_path="$(realpath --relative-to="$current_dir" -- "$target_path" 2>/dev/null || true)"
  fi

  if [ -z "$relative_path" ]; then
    relative_path="$target_path"
  fi

  case "$relative_path" in
    ./*|../*|/*)
      ;;
    *)
      relative_path="./$relative_path"
      ;;
  esac

  printf '%s\n' "$relative_path"
}

build_open_command() {
  local current_dir="$1"
  local target_path="$2"
  local relative_path=""
  local open_command=""

  relative_path="$(relative_open_path "$current_dir" "$target_path")"
  printf -v open_command 'nvim %q' "$relative_path"
  printf '%s\n' "$open_command"
}

send_shell_open_command() {
  local pane_id="$1"
  local selected_path="$2"
  local current_path=""
  local open_command=""

  current_path="$(pane_path "$pane_id")"
  open_command="$(build_open_command "$current_path" "$selected_path")"

  tmux send-keys -t "$pane_id" C-u "$open_command" C-m >/dev/null 2>&1
}

submit_prefilled_open_command() {
  local pane_id="$1"

  tmux send-keys -t "$pane_id" C-m >/dev/null 2>&1
}

send_vim_drop_keys() {
  local pane_id="$1"
  local selected_path="$2"
  local current_path=""
  local relative_path=""
  local escaped_path=""
  local command=""

  current_path="$(pane_path "$pane_id")"
  relative_path="$(relative_open_path "$current_path" "$selected_path")"
  escaped_path="$(vim_single_quote_escape "$relative_path")"
  printf -v command ":execute 'drop ' .. fnameescape('%s')" "$escaped_path"
  tmux send-keys -t "$pane_id" C-\\ C-n Escape "$command" Enter >/dev/null 2>&1
}

wait_for_shell() {
  local pane_id="$1"
  local attempts=20
  local current_command=""

  while [ "$attempts" -gt 0 ]; do
    current_command="$(pane_command "$pane_id")"
    if is_shell_command "$current_command"; then
      return 0
    fi
    sleep 0.1
    attempts=$((attempts - 1))
  done

  return 1
}

wait_for_path_sync() {
  local pane_id="$1"
  local expected_path="$2"
  local attempts=10
  local current_path=""

  [ -n "$expected_path" ] || return 0

  while [ "$attempts" -gt 0 ]; do
    current_path="$(pane_path "$pane_id")"
    if [ "$current_path" = "$expected_path" ]; then
      return 0
    fi
    sleep 0.1
    attempts=$((attempts - 1))
  done

  return 1
}

workspace_dir="$(tmux_option @broot_workspace_dir)"
selection_output="$(tmux_option @broot_selection_output)"
terminal_pane="$(tmux_option @codex_terminal_pane_id)"
terminal_dir="$(tmux_option @codex_terminal_dir)"
prefilled_selection="$(tmux_option @codex_terminal_prefilled_selection)"
prefilled_command="$(tmux_option @codex_terminal_prefilled_command)"
selection_path="$(read_selection_path "$selection_output" "$workspace_dir")"
selected_dir="$(selection_target_dir "$selection_path")"
current_command=""
expected_open_command=""

[ -n "$terminal_pane" ] || exit 0

if [ -n "$selected_dir" ]; then
  terminal_dir="$selected_dir"
  tmux set-option -q -t "$session_name" @codex_terminal_dir "$terminal_dir" >/dev/null 2>&1 || true
fi

if ! pane_live "$terminal_pane"; then
  tmux respawn-pane -k -t "$terminal_pane" -c "${terminal_dir:-${workspace_dir:-.}}" "$SCRIPT_ROOT/bin/codex-terminal-shell" >/dev/null 2>&1 || exit 0
fi

current_command="$(pane_command "$terminal_pane")"

if [ -n "$selection_path" ] && [ -f "$selection_path" ]; then
  expected_open_command="$(build_open_command "${selected_dir:-$(pane_path "$terminal_pane")}" "$selection_path")"
  if is_shell_command "$current_command" || wait_for_shell "$terminal_pane"; then
    wait_for_path_sync "$terminal_pane" "$selected_dir" || true
    if [ "$prefilled_selection" = "$selection_path" ] && [ -n "$prefilled_command" ] && [ "$prefilled_command" = "$expected_open_command" ] && pane_contains_text "$terminal_pane" "$prefilled_command"; then
      if submit_prefilled_open_command "$terminal_pane"; then
        set_activated_selection "$selection_path"
        clear_prefill_options
      fi
    else
      if send_shell_open_command "$terminal_pane" "$selection_path"; then
        set_activated_selection "$selection_path"
        clear_prefill_options
      fi
    fi
  elif is_vim_command "$current_command"; then
    if send_vim_drop_keys "$terminal_pane" "$selection_path"; then
      set_activated_selection "$selection_path"
      clear_prefill_options
    fi
  fi
fi

tmux select-pane -t "$terminal_pane" >/dev/null 2>&1 || true

#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMUX_CONFIG="${TMUX_CONFIG:-$SCRIPT_ROOT/.tmux/tmux.conf}"
TMUX_SESSION_NAME="codex-nvim-pane-smoke-$$"
tmux_cmd=(tmux -u -f "$TMUX_CONFIG")

tmp_dir="$(mktemp -d /tmp/codex-nvim-pane.XXXXXX)"
repo_root="$tmp_dir/repo"
selection_output="$tmp_dir/selection.txt"
state_file="$tmp_dir/editor-state.tsv"
socket_path="$tmp_dir/nvim.sock"
real_nvim="$(command -v nvim)"
nvim_wrapper_dir="$tmp_dir/bin"
test_path="$nvim_wrapper_dir:$PATH"
remote_log="$tmp_dir/nvim-remote.log"
window_name="repo-window"
codex_pane=""
broot_pane=""
editor_pane=""

window_target() {
  local target
  target="$("${tmux_cmd[@]}" show-options -qv -t "$TMUX_SESSION_NAME" @codex_window_id)"
  if [ -n "$target" ]; then
    printf '%s\n' "$target"
    return 0
  fi
  printf '%s\n' "$TMUX_SESSION_NAME:0"
}

cleanup() {
  "${tmux_cmd[@]}" kill-session -t "$TMUX_SESSION_NAME" >/dev/null 2>&1 || true
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

pane_width() {
  "${tmux_cmd[@]}" display-message -p -t "$1" '#{pane_width}'
}

pane_left() {
  "${tmux_cmd[@]}" display-message -p -t "$1" '#{pane_left}'
}

pane_count() {
  "${tmux_cmd[@]}" list-panes -t "$(window_target)" -F '#{pane_id}' | wc -l | tr -d '[:space:]'
}

window_width() {
  "${tmux_cmd[@]}" display-message -p -t "$1" '#{window_width}'
}

active_pane() {
  "${tmux_cmd[@]}" display-message -p -t "$(window_target)" '#{pane_id}'
}

pane_dead() {
  "${tmux_cmd[@]}" display-message -p -t "$1" '#{pane_dead}' 2>/dev/null || printf '1\n'
}

wait_for_socket() {
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    if [ -S "$socket_path" ] && nvim --server "$socket_path" --remote-expr '1' >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_for_regex_in_file() {
  local path="$1"
  local regex="$2"
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    if [ -f "$path" ] && grep -Eq "$regex" "$path"; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_for_empty_file() {
  local path="$1"
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    if [ ! -s "$path" ]; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_for_active_pane() {
  local expected="$1"
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    if [ "$(active_pane)" = "$expected" ]; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_for_remote_expr() {
  local expr="$1"
  local expected="$2"
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    if [ "$(nvim --server "$socket_path" --remote-expr "$expr" 2>/dev/null || true)" = "$expected" ]; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_for_editor_teardown() {
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    editor_pane="$("${tmux_cmd[@]}" show-options -qv -t "$TMUX_SESSION_NAME" @codex_nvim_pane_id)"
    if [ -z "$editor_pane" ] && [ ! -S "$socket_path" ]; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_for_editor_pane() {
  local deadline=$((SECONDS + 10))
  while (( SECONDS < deadline )); do
    editor_pane="$("${tmux_cmd[@]}" show-options -qv -t "$TMUX_SESSION_NAME" @codex_nvim_pane_id)"
    if [ -n "$editor_pane" ] && [ "$(pane_dead "$editor_pane")" = "0" ]; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

headless_invocations() {
  grep -c '^headless ' "$remote_log" 2>/dev/null || true
}

assert_equals() {
  local expected="$1"
  local actual="$2"
  local message="$3"
  if [ "$expected" != "$actual" ]; then
    printf '%s\nexpected: %s\nactual:   %s\n' "$message" "$expected" "$actual" >&2
    exit 1
  fi
}

assert_width() {
  local expected="$1"
  local pane_id="$2"
  local message="$3"
  assert_equals "$expected" "$(pane_width "$pane_id")" "$message"
}

assert_less_than() {
  local lhs="$1"
  local rhs="$2"
  local message="$3"
  if [ "$lhs" -ge "$rhs" ]; then
    printf '%s\nleft:  %s\nright: %s\n' "$message" "$lhs" "$rhs" >&2
    exit 1
  fi
}

setup_nvim_wrapper() {
  mkdir -p "$nvim_wrapper_dir"
  cat >"$nvim_wrapper_dir/nvim" <<EOF
#!/usr/bin/env bash
set -euo pipefail
if [ "\${1:-}" = "--headless" ]; then
  printf 'headless args=%s\n' "\$*" >>"$remote_log"
  exit 0
elif [ "\${1:-}" = "--server" ]; then
  if [ -t 0 ]; then
    tty_stdin=1
  else
    tty_stdin=0
  fi
  printf 'server stdin_tty=%s tmux_pane=%s args=%s\n' "\$tty_stdin" "\${TMUX_PANE:-}" "\$*" >>"$remote_log"
else
  sleep 0.3
fi
exec "$real_nvim" "\$@"
EOF
  chmod +x "$nvim_wrapper_dir/nvim"
}

launch_tmux() {
  mkdir -p "$repo_root"
  mkdir -p "$repo_root/config/nvim/lua/config"
  printf 'one\n' >"$repo_root/one.txt"
  printf 'two\n' >"$repo_root/two.txt"
  cat >"$repo_root/config/nvim/init.lua" <<'EOF'
require("config")
EOF
  cat >"$repo_root/config/nvim/lua/config/init.lua" <<'EOF'
require("config.lazy")
EOF
  cat >"$repo_root/config/nvim/lua/config/lazy.lua" <<'EOF'
vim.g.codex_nvim_prewarm_smoke = true
EOF
  : >"$selection_output"
  : >"$state_file"
  : >"$remote_log"

  "${tmux_cmd[@]}" new-session -d -s "$TMUX_SESSION_NAME" -x 120 -y 40 'bash'
  window_id="$("${tmux_cmd[@]}" display-message -p -t "$TMUX_SESSION_NAME:0" '#{window_id}')"
  "${tmux_cmd[@]}" rename-window -t "$window_id" "$window_name"
  "${tmux_cmd[@]}" set-environment -t "$TMUX_SESSION_NAME" PATH "$test_path"
  codex_pane="$("${tmux_cmd[@]}" display-message -p -t "$window_id" '#{pane_id}')"
  broot_pane="$("${tmux_cmd[@]}" split-window -d -h -b -P -F '#{pane_id}' -t "$codex_pane" 'bash')"

  "${tmux_cmd[@]}" set-option -t "$TMUX_SESSION_NAME" @codex_repo_name "$window_name"
  "${tmux_cmd[@]}" set-option -t "$TMUX_SESSION_NAME" @codex_window_id "$window_id"
  "${tmux_cmd[@]}" set-option -t "$TMUX_SESSION_NAME" @codex_pane_id "$codex_pane"
  "${tmux_cmd[@]}" set-option -t "$TMUX_SESSION_NAME" @broot_pane_id "$broot_pane"
  "${tmux_cmd[@]}" set-option -t "$TMUX_SESSION_NAME" @broot_runtime_dir "$tmp_dir/runtime"
  "${tmux_cmd[@]}" set-option -t "$TMUX_SESSION_NAME" @broot_workspace_dir "$repo_root"
  "${tmux_cmd[@]}" set-option -t "$TMUX_SESSION_NAME" @broot_selection_output "$selection_output"
  "${tmux_cmd[@]}" set-option -t "$TMUX_SESSION_NAME" @codex_nvim_socket "$socket_path"
  "${tmux_cmd[@]}" set-option -t "$TMUX_SESSION_NAME" @codex_nvim_state_file "$state_file"

  "$SCRIPT_ROOT/bin/codex-layout" two-column "$TMUX_SESSION_NAME"
}

require_command grep
require_command nvim
require_command tmux

setup_nvim_wrapper
export PATH="$test_path"
launch_tmux
"${tmux_cmd[@]}" select-pane -t "$broot_pane"
assert_equals "2" "$(pane_count)" 'startup should only create codex and broot panes'
two_column_side=48
assert_width "$two_column_side" "$codex_pane" 'two-column layout did not keep the codex pane at 48 columns'
assert_width "$(( $(window_width "$codex_pane") - two_column_side - 1 ))" "$broot_pane" 'two-column layout did not leave the broot pane as the remaining width'
assert_less_than "$(pane_left "$broot_pane")" "$(pane_left "$codex_pane")" 'startup should place the broot pane to the left of Codex'

TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" "$repo_root/one.txt"
editor_pane="$("${tmux_cmd[@]}" show-options -qv -t "$TMUX_SESSION_NAME" @codex_nvim_pane_id)"
if [ -z "$editor_pane" ] || [ "$(pane_dead "$editor_pane")" != "0" ]; then
  printf 'editor pane was not created during the async cold start\n' >&2
  exit 1
fi
assert_equals "$broot_pane" "$(active_pane)" 'first open shifted focus before Neovim became ready'
if [ -S "$socket_path" ] && nvim --server "$socket_path" --remote-expr '1' >/dev/null 2>&1; then
  printf 'first open blocked until the Neovim socket was ready\n' >&2
  exit 1
fi
if ! wait_for_socket; then
  printf 'nvim socket never became ready\n' >&2
  exit 1
fi
if ! wait_for_regex_in_file "$remote_log" "^headless args=--headless .*\\+Lazy! install .*\\+qa$"; then
  printf 'expected a headless Neovim prewarm before the visible editor startup\n' >&2
  cat "$remote_log" >&2 || true
  exit 1
fi
assert_equals "1" "$(headless_invocations)" 'prewarm should run exactly once before the first visible open'
assert_equals "yes" "$(test -f "$tmp_dir/runtime/nvim-prewarm-ready" && echo yes || echo no)" 'prewarm did not leave a ready marker'
if ! wait_for_active_pane "$editor_pane"; then
  printf 'focus never moved into the Neovim pane after startup\n' >&2
  exit 1
fi
assert_equals "3" "$(pane_count)" 'opening a file should add a single Neovim pane'

three_column_side=48
three_column_middle="$(( $(window_width "$codex_pane") - three_column_side - three_column_side - 2 ))"
assert_width "$three_column_side" "$broot_pane" 'three-column layout did not keep the broot pane at 48 columns'
assert_width "$three_column_middle" "$editor_pane" 'three-column layout did not leave the editor pane as the remaining width'
assert_width "$three_column_side" "$codex_pane" 'three-column layout did not keep the codex pane at 48 columns'
assert_less_than "$(pane_left "$broot_pane")" "$(pane_left "$editor_pane")" 'editor pane should open to the right of broot'
assert_less_than "$(pane_left "$editor_pane")" "$(pane_left "$codex_pane")" 'editor pane should open to the left of Codex'

assert_equals "$repo_root/one.txt" "$(nvim --server "$socket_path" --remote-expr 'expand("%:p")')" 'first open did not select the requested buffer'
if ! wait_for_regex_in_file "$state_file" "^0[[:space:]]+$repo_root/one\\.txt$"; then
  printf 'state file never reflected the first clean buffer\n' >&2
  cat "$state_file" >&2 || true
  exit 1
fi

TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" "$repo_root/two.txt"
assert_equals "$editor_pane" "$("${tmux_cmd[@]}" show-options -qv -t "$TMUX_SESSION_NAME" @codex_nvim_pane_id)" 'second open did not reuse the existing editor pane'
assert_equals "$repo_root/two.txt" "$(nvim --server "$socket_path" --remote-expr 'expand("%:p")')" 'second open did not focus the requested buffer'
assert_equals "['$repo_root/one.txt', '$repo_root/two.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" 'expected both file buffers to stay open in Neovim'
if ! wait_for_regex_in_file "$remote_log" "server stdin_tty=0 tmux_pane=$broot_pane"; then
  printf 'expected tmux-triggered remote Neovim calls to run detached from the pane tty\n' >&2
  cat "$remote_log" >&2 || true
  exit 1
fi
if grep -Eq "server stdin_tty=1 tmux_pane=$broot_pane" "$remote_log"; then
  printf 'tmux-triggered remote Neovim calls should not inherit the pane tty\n' >&2
  cat "$remote_log" >&2 || true
  exit 1
fi

nvim --server "$socket_path" --remote-send ':q<CR>'
if ! wait_for_remote_expr 'expand("%:p")' "$repo_root/one.txt"; then
  printf 'plain :q did not keep the editor pane alive on the fallback buffer\n' >&2
  exit 1
fi
assert_equals "['$repo_root/one.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" 'plain :q did not remove the closed buffer'
if ! wait_for_regex_in_file "$state_file" "^0[[:space:]]+$repo_root/one\\.txt$"; then
  printf 'state file did not collapse to the fallback buffer after plain :q\n' >&2
  cat "$state_file" >&2 || true
  exit 1
fi

TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" "$repo_root/two.txt"
nvim --server "$socket_path" --remote-expr 'execute("call setline(1, [\"changed\"]) | echo &modified")' >/dev/null
if ! wait_for_regex_in_file "$state_file" "^1[[:space:]]+$repo_root/two\\.txt$"; then
  printf 'state file never reflected a modified buffer\n' >&2
  cat "$state_file" >&2 || true
  exit 1
fi

nvim --server "$socket_path" --remote-send ':q<CR>'
sleep 0.2
assert_equals "$repo_root/two.txt" "$(nvim --server "$socket_path" --remote-expr 'expand("%:p")')" 'plain :q on a modified buffer should keep the current buffer visible'
assert_equals "['$repo_root/one.txt', '$repo_root/two.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" 'plain :q on a modified buffer should not remove any buffers'
if ! wait_for_regex_in_file "$state_file" "^1[[:space:]]+$repo_root/two\\.txt$"; then
  printf 'modified buffer state should remain after a refused plain :q\n' >&2
  cat "$state_file" >&2 || true
  exit 1
fi

nvim --server "$socket_path" --remote-send ':q!<CR>'
if ! wait_for_remote_expr 'expand("%:p")' "$repo_root/one.txt"; then
  printf ':q! did not keep the editor pane alive on the fallback buffer\n' >&2
  exit 1
fi
assert_equals "['$repo_root/one.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" ':q! did not remove the force-closed buffer'
assert_equals "two" "$(cat "$repo_root/two.txt")" ':q! should not have written the modified file'

TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" "$repo_root/two.txt"
nvim --server "$socket_path" --remote-expr 'execute("call setline(1, [\"saved\"]) | echo &modified")' >/dev/null
nvim --server "$socket_path" --remote-send 'ZZ'
if ! wait_for_remote_expr 'expand("%:p")' "$repo_root/one.txt"; then
  printf 'ZZ did not return to the fallback buffer after saving\n' >&2
  exit 1
fi
assert_equals "['$repo_root/one.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" 'ZZ did not remove the written buffer'
assert_equals "saved" "$(cat "$repo_root/two.txt")" 'ZZ did not write the modified file before closing it'

nvim --server "$socket_path" --remote-send ':q<CR>'
if ! wait_for_editor_teardown; then
  printf 'editor pane never tore down after quitting the last file buffer\n' >&2
  exit 1
fi
if ! wait_for_empty_file "$state_file"; then
  printf 'state file was not cleared when the editor exited\n' >&2
  cat "$state_file" >&2 || true
  exit 1
fi
assert_equals "2" "$(pane_count)" 'quitting the last file should restore the two-pane layout'

restored_side=48
assert_width "$restored_side" "$codex_pane" 'teardown did not restore the codex pane width'
assert_width "$(( $(window_width "$codex_pane") - restored_side - 1 ))" "$broot_pane" 'teardown did not restore the broot pane width'
assert_less_than "$(pane_left "$broot_pane")" "$(pane_left "$codex_pane")" 'teardown should restore broot to the left of Codex'

TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" "$repo_root/one.txt"
if ! wait_for_socket; then
  printf 'nvim socket never became ready on the warm reopen\n' >&2
  exit 1
fi
assert_equals "1" "$(headless_invocations)" 'warm reopen should reuse the ready marker instead of rerunning prewarm'
nvim --server "$socket_path" --remote-send ':q<CR>'
if ! wait_for_editor_teardown; then
  printf 'editor pane never tore down after the warm reopen quit\n' >&2
  exit 1
fi

TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" --preview "$repo_root/one.txt"
editor_pane="$("${tmux_cmd[@]}" show-options -qv -t "$TMUX_SESSION_NAME" @codex_nvim_pane_id)"
if [ -z "$editor_pane" ] || [ "$(pane_dead "$editor_pane")" != "0" ]; then
  printf 'preview mode did not create an editor pane during the async cold start\n' >&2
  exit 1
fi
assert_equals "$broot_pane" "$(active_pane)" 'preview mode should keep focus in broot before Neovim becomes ready'
TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" --preview "$repo_root/two.txt"
assert_equals "$editor_pane" "$("${tmux_cmd[@]}" show-options -qv -t "$TMUX_SESSION_NAME" @codex_nvim_pane_id)" 'preview mode should reuse the same editor pane while Neovim is starting'
if ! wait_for_socket; then
  printf 'nvim socket never became ready during preview mode\n' >&2
  exit 1
fi
assert_equals "$broot_pane" "$(active_pane)" 'preview mode should keep focus in broot after Neovim becomes ready'
assert_equals "$repo_root/two.txt" "$(nvim --server "$socket_path" --remote-expr 'expand("%:p")')" 'preview mode did not land on the latest selected file after startup'
assert_equals "['$repo_root/two.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" 'preview mode should discard the superseded startup preview buffer'

TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" --preview "$repo_root/one.txt"
assert_equals "$editor_pane" "$("${tmux_cmd[@]}" show-options -qv -t "$TMUX_SESSION_NAME" @codex_nvim_pane_id)" 'preview mode did not reuse the existing editor pane'
assert_equals "$broot_pane" "$(active_pane)" 'preview mode should not move focus into Neovim on subsequent updates'
assert_equals "$repo_root/one.txt" "$(nvim --server "$socket_path" --remote-expr 'expand("%:p")')" 'preview mode did not switch to the newly selected buffer'
assert_equals "['$repo_root/one.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" 'preview mode should keep only the current unmodified preview buffer listed'

TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" "$repo_root/one.txt"
if ! wait_for_active_pane "$editor_pane"; then
  printf 'explicit open did not focus the previewed buffer\n' >&2
  exit 1
fi
assert_equals "['$repo_root/one.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" 'explicit open of the current preview should pin the buffer without duplicating it'

TMUX_PANE="$broot_pane" "$SCRIPT_ROOT/bin/codex-open-in-vim" --preview "$repo_root/two.txt"
assert_equals "$repo_root/two.txt" "$(nvim --server "$socket_path" --remote-expr 'expand("%:p")')" 'preview mode did not switch away from the pinned buffer'
assert_equals "['$repo_root/one.txt', '$repo_root/two.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" 'preview mode should keep explicitly opened buffers while replacing preview buffers'

nvim --server "$socket_path" --remote-send ':q<CR>'
if ! wait_for_remote_expr 'expand("%:p")' "$repo_root/one.txt"; then
  printf 'preview buffer quit did not fall back to the pinned buffer\n' >&2
  exit 1
fi
nvim --server "$socket_path" --remote-send ':q<CR>'
if ! wait_for_editor_teardown; then
  printf 'editor pane never tore down after closing the pinned preview session\n' >&2
  exit 1
fi

printf -v watcher_cmd 'CODEX_BROOT_PREVIEW_POLL_INTERVAL=0.05 bash %q %q >/dev/null 2>&1' \
  "$SCRIPT_ROOT/bin/codex-watch-broot-selection-preview" \
  "$TMUX_SESSION_NAME"
"${tmux_cmd[@]}" run-shell -b "$watcher_cmd"

printf '%s\n' "$repo_root" >"$selection_output"
sleep 0.2
assert_equals "" "$("${tmux_cmd[@]}" show-options -qv -t "$TMUX_SESSION_NAME" @codex_nvim_pane_id)" 'selection watcher should ignore directory rows'

printf '%s\n' "$repo_root/one.txt" >"$selection_output"
if ! wait_for_editor_pane; then
  printf 'selection watcher never opened an editor pane for a text file\n' >&2
  exit 1
fi
assert_equals "$broot_pane" "$(active_pane)" 'selection watcher should keep focus in broot before Neovim becomes ready'
printf '%s\n' "$repo_root/two.txt" >"$selection_output"
if ! wait_for_socket; then
  printf 'selection watcher never reached a ready Neovim socket\n' >&2
  exit 1
fi
assert_equals "$broot_pane" "$(active_pane)" 'selection watcher should keep focus in broot after Neovim becomes ready'
if ! wait_for_remote_expr 'expand("%:p")' "$repo_root/two.txt"; then
  printf 'selection watcher did not preview the latest selected file\n' >&2
  exit 1
fi
assert_equals "['$repo_root/two.txt']" "$(nvim --server "$socket_path" --remote-expr 'string(map(getbufinfo({"buflisted":1}), "v:val.name"))')" 'selection watcher should discard superseded preview buffers'

printf '\000\001\002' >"$repo_root/binary.bin"
printf '%s\n' "$repo_root/binary.bin" >"$selection_output"
sleep 0.2
assert_equals "$repo_root/two.txt" "$(nvim --server "$socket_path" --remote-expr 'expand("%:p")')" 'selection watcher should ignore non-text files'

nvim --server "$socket_path" --remote-send ':q<CR>'
if ! wait_for_editor_teardown; then
  printf 'selection watcher editor pane never tore down after quit\n' >&2
  exit 1
fi

printf 'codex nvim pane smoke test passed\n'

#!/usr/bin/env bash
set -euo pipefail

file_path="${1:?missing file path}"
line_number="${2:-1}"
target_pane="${TMUX_PANE:-}"
pane_width="${BROOT_PANE_WIDTH:-45}"

if [[ ! "$line_number" =~ ^[0-9]+$ ]] || [ "$line_number" -lt 1 ]; then
  line_number=1
fi

if [ -z "${TMUX:-}" ] || [ -z "$target_pane" ]; then
  exec nvim "+${line_number}" -- "$file_path"
fi

working_dir="$(dirname "$file_path")"
editor_cmd="exec nvim +${line_number} -- $(printf '%q' "$file_path")"

tmux split-window -h -t "$target_pane" -c "$working_dir" "$editor_cmd"
tmux resize-pane -t "$target_pane" -x "$pane_width" >/dev/null 2>&1 || true

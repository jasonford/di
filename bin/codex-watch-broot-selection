#!/usr/bin/env bash
set -euo pipefail

POLL_INTERVAL="${CODEX_BROOT_SELECTION_POLL_INTERVAL:-0.1}"

if [ "$#" -gt 1 ]; then
  printf 'usage: codex-watch-broot-selection [tmux-session-name]\n' >&2
  exit 1
fi

session_name="${1:-}"
if [ -z "$session_name" ]; then
  if [ -z "${TMUX_PANE:-}" ]; then
    printf 'codex-watch-broot-selection needs a tmux session name or TMUX_PANE\n' >&2
    exit 1
  fi
  session_name="$(tmux display-message -p -t "$TMUX_PANE" '#S')"
fi

tmux_option() {
  tmux show-options -qv -t "$session_name" "$1" 2>/dev/null || true
}

pane_format() {
  tmux display-message -p -t "$1" "$2" 2>/dev/null || true
}

pane_live() {
  local pane_id="$1"
  [ -n "$pane_id" ] || return 1
  [ "$(pane_format "$pane_id" '#{pane_dead}')" = "0" ]
}

clear_prefill_options() {
  tmux set-option -q -t "$session_name" @codex_terminal_prefilled_selection "" >/dev/null 2>&1 || true
  tmux set-option -q -t "$session_name" @codex_terminal_prefilled_command "" >/dev/null 2>&1 || true
}

set_prefill_options() {
  tmux set-option -q -t "$session_name" @codex_terminal_prefilled_selection "$1" >/dev/null 2>&1 || true
  tmux set-option -q -t "$session_name" @codex_terminal_prefilled_command "$2" >/dev/null 2>&1 || true
}

normalize_path() {
  local path="$1"
  [ -n "$path" ] || return 0
  realpath -m -- "$path" 2>/dev/null || printf '%s\n' "$path"
}

relative_cd_path() {
  local current_dir="$1"
  local target_dir="$2"
  local relative_path=""

  relative_path="$(realpath --relative-to="$current_dir" -- "$target_dir" 2>/dev/null || true)"
  if [ -z "$relative_path" ]; then
    relative_path="$target_dir"
  fi

  case "$relative_path" in
    "")
      relative_path="."
      ;;
    -*)
      relative_path="./$relative_path"
      ;;
  esac

  printf '%s\n' "$relative_path"
}

is_shell_command() {
  case "$1" in
    bash|sh|zsh|fish)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

read_selection() {
  local raw=""
  if [ -f "$selection_output" ]; then
    IFS= read -r raw < "$selection_output" || true
  fi
  if [ -z "$raw" ]; then
    printf '\n'
    return 0
  fi
  if [[ "$raw" != /* ]]; then
    raw="${workspace_dir:-.}/$raw"
  fi
  normalize_path "$raw"
}

selection_target_dir() {
  local selection_path="$1"

  [ -n "$selection_path" ] || return 0

  if [ -d "$selection_path" ]; then
    printf '%s\n' "$selection_path"
    return 0
  fi

  if [ -e "$selection_path" ]; then
    normalize_path "$(dirname -- "$selection_path")"
  fi
}

selection_open_file() {
  local selection_path="$1"

  [ -n "$selection_path" ] || return 0

  if [ -f "$selection_path" ]; then
    printf '%s\n' "$selection_path"
  fi
}

relative_open_path() {
  local current_dir="$1"
  local target_path="$2"
  local relative_path=""

  if [ -n "$current_dir" ] && [ -n "$target_path" ]; then
    relative_path="$(realpath --relative-to="$current_dir" -- "$target_path" 2>/dev/null || true)"
  fi

  if [ -z "$relative_path" ]; then
    relative_path="$target_path"
  fi

  case "$relative_path" in
    ./*|../*|/*)
      ;;
    *)
      relative_path="./$relative_path"
      ;;
  esac

  printf '%s\n' "$relative_path"
}

build_open_command() {
  local current_dir="$1"
  local target_path="$2"
  local relative_path=""
  local open_command=""

  relative_path="$(relative_open_path "$current_dir" "$target_path")"
  printf -v open_command 'nvim %q' "$relative_path"
  printf '%s\n' "$open_command"
}

sync_terminal_pane() {
  local terminal_pane="$1"
  local target_dir="$2"
  local current_command=""
  local current_path=""
  local cd_path=""
  local cd_command=""

  if ! pane_live "$terminal_pane"; then
    return 1
  fi

  current_command="$(pane_format "$terminal_pane" '#{pane_current_command}')"
  if ! is_shell_command "$current_command"; then
    return 1
  fi

  current_path="$(pane_format "$terminal_pane" '#{pane_current_path}')"
  current_path="$(normalize_path "$current_path")"
  if [ "$current_path" = "$target_dir" ]; then
    return 0
  fi

  cd_path="$(relative_cd_path "$current_path" "$target_dir")"
  printf -v cd_command 'cd %q' "$cd_path"
  tmux send-keys -t "$terminal_pane" C-u "$cd_command" C-m >/dev/null 2>&1 || return 1
  return 0
}

prefill_terminal_open_command() {
  local terminal_pane="$1"
  local target_dir="$2"
  local selected_path="$3"
  local current_command=""
  local open_command=""

  if ! pane_live "$terminal_pane"; then
    return 1
  fi

  current_command="$(pane_format "$terminal_pane" '#{pane_current_command}')"
  if ! is_shell_command "$current_command"; then
    return 1
  fi

  open_command="$(build_open_command "$target_dir" "$selected_path")"
  tmux send-keys -t "$terminal_pane" C-u "$open_command" >/dev/null 2>&1 || return 1
  printf '%s\n' "$open_command"
}

clear_terminal_prefill() {
  local terminal_pane="$1"
  local current_command=""

  if ! pane_live "$terminal_pane"; then
    return 1
  fi

  current_command="$(pane_format "$terminal_pane" '#{pane_current_command}')"
  if ! is_shell_command "$current_command"; then
    return 1
  fi

  tmux send-keys -t "$terminal_pane" C-u >/dev/null 2>&1 || return 1
  return 0
}

selection_output="$(tmux_option @broot_selection_output)"
workspace_dir="$(tmux_option @broot_workspace_dir)"
runtime_dir="$(tmux_option @broot_runtime_dir)"

[ -n "$selection_output" ] || exit 0

lock_root="${runtime_dir:-$(dirname -- "$selection_output")}"
mkdir -p "$lock_root"
exec 9>"$lock_root/terminal-dir-sync.lock"
flock -n 9 || exit 0

selected_dir=""
selected_file=""
applied_dir=""
applied_open_command=""

clear_prefill_options

while tmux has-session -t "$session_name" 2>/dev/null; do
  next_dir=""
  next_file=""
  desired_open_command=""
  selection_path="$(read_selection)"

  next_dir="$(selection_target_dir "$selection_path")"
  next_file="$(selection_open_file "$selection_path")"
  if [ -n "$next_dir" ] && [ -n "$next_file" ]; then
    desired_open_command="$(build_open_command "$next_dir" "$next_file")"
  fi

  if [ "$next_dir" != "$selected_dir" ] || [ "$next_file" != "$selected_file" ]; then
    selected_dir="$next_dir"
    selected_file="$next_file"
    applied_dir=""
    clear_prefill_options
    if [ -n "$selected_dir" ]; then
      tmux set-option -q -t "$session_name" @codex_terminal_dir "$selected_dir" >/dev/null 2>&1 || true
    fi
  fi

  terminal_pane="$(tmux_option @codex_terminal_pane_id)"

  if [ -n "$applied_open_command" ]; then
    if ! pane_live "$terminal_pane" || ! is_shell_command "$(pane_format "$terminal_pane" '#{pane_current_command}')"; then
      applied_open_command=""
      clear_prefill_options
    fi
  fi

  if [ -n "$selected_dir" ] && [ "$applied_dir" != "$selected_dir" ]; then
    if sync_terminal_pane "$terminal_pane" "$selected_dir"; then
      applied_dir="$selected_dir"
      applied_open_command=""
      clear_prefill_options
    fi
  fi

  if [ -z "$selected_dir" ]; then
    applied_dir=""
  fi

  if [ -n "$desired_open_command" ] && [ "$applied_dir" = "$selected_dir" ] && [ "$applied_open_command" != "$desired_open_command" ]; then
    applied_open_command="$(prefill_terminal_open_command "$terminal_pane" "$selected_dir" "$selected_file" || true)"
    if [ -n "$applied_open_command" ]; then
      set_prefill_options "$selected_file" "$applied_open_command"
    fi
  elif [ -z "$desired_open_command" ] && [ -n "$applied_open_command" ]; then
    if clear_terminal_prefill "$terminal_pane"; then
      applied_open_command=""
      clear_prefill_options
    fi
  fi

  sleep "$POLL_INTERVAL"
done

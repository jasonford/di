#!/usr/bin/env bash
set -euo pipefail

file_path="${1:?missing file path}"

mime="$(file --mime --brief --dereference "$file_path")"
if [[ "$mime" == *"charset=binary"* ]]; then
  file --brief --dereference "$file_path"
  exit 0
fi

git_root=""
if git_root="$(git -C "$(dirname "$file_path")" rev-parse --show-toplevel 2>/dev/null)"; then
  rel_path="$(realpath --relative-to="$git_root" "$file_path")"
  if git -C "$git_root" ls-files --error-unmatch -- "$rel_path" >/dev/null 2>&1; then
    if git -C "$git_root" rev-parse --verify HEAD >/dev/null 2>&1; then
      if ! git -C "$git_root" diff --quiet HEAD -- "$rel_path" >/dev/null 2>&1; then
        exec git -C "$git_root" diff --color=always --no-ext-diff --unified=999999 HEAD -- "$rel_path"
      fi
    else
      if ! git -C "$git_root" diff --quiet -- "$rel_path" >/dev/null 2>&1; then
        exec git -C "$git_root" diff --color=always --no-ext-diff --unified=999999 -- "$rel_path"
      fi
    fi
  else
    exec git -C "$git_root" diff --color=always --no-ext-diff --unified=999999 --no-index /dev/null "$file_path"
  fi
fi

exec cat -- "$file_path"

#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  printf 'usage: codex-prepare-broot-config <xdg-config-home>\n' >&2
  exit 1
fi

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target_dir="$1/broot"

mkdir -p "$target_dir"
cp "$script_root/config/broot/conf.hjson" "$target_dir/conf.hjson"
cp "$script_root/config/broot/verbs.hjson" "$target_dir/verbs.hjson"

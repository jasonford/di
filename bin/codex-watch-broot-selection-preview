#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: codex-watch-broot-selection-preview <session-name>\n' >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 1
fi

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
session_name="$1"
poll_interval="${CODEX_BROOT_PREVIEW_POLL_INTERVAL:-0.1}"
pid_option="@codex_broot_preview_watcher_pid"
last_selection=""

tmux_option() {
  tmux show-options -qv -t "$session_name" "$1" 2>/dev/null || true
}

session_live() {
  tmux has-session -t "$session_name" >/dev/null 2>&1
}

register_watcher() {
  local existing_pid

  existing_pid="$(tmux_option "$pid_option")"
  if [ -n "$existing_pid" ] && kill -0 "$existing_pid" >/dev/null 2>&1; then
    exit 0
  fi

  tmux set-option -t "$session_name" "$pid_option" "$$"
}

cleanup() {
  local current_pid

  if ! session_live; then
    return
  fi

  current_pid="$(tmux_option "$pid_option")"
  if [ "$current_pid" = "$$" ]; then
    tmux set-option -qu -t "$session_name" "$pid_option"
  fi
}

read_selection() {
  local selection_file="$1"
  local raw=""

  if [ -f "$selection_file" ]; then
    IFS= read -r raw <"$selection_file" || true
  fi

  printf '%s\n' "$raw"
}

normalize_selection() {
  local workspace_dir="$1"
  local selected_path="$2"

  case "$selected_path" in
    /*)
      realpath -m -- "$selected_path"
      ;;
    *)
      realpath -m -- "$workspace_dir/$selected_path"
      ;;
  esac
}

previewable_path() {
  local selected_path="$1"
  local mime_type=""

  [ -f "$selected_path" ] || return 1

  mime_type="$(file --brief --mime-type --dereference -- "$selected_path" 2>/dev/null || true)"
  case "$mime_type" in
    inode/x-empty|text/*|application/json|application/xml|application/javascript|image/svg+xml)
      return 0
      ;;
  esac

  return 1
}

if ! session_live; then
  exit 0
fi

selection_file="$(tmux_option @broot_selection_output)"
workspace_dir="$(tmux_option @broot_workspace_dir)"
broot_pane="$(tmux_option @broot_pane_id)"

if [ -z "$selection_file" ] || [ -z "$workspace_dir" ] || [ -z "$broot_pane" ]; then
  exit 0
fi

register_watcher
trap cleanup EXIT HUP INT TERM

while session_live; do
  selected_raw="$(read_selection "$selection_file")"
  if [ -n "$selected_raw" ]; then
    selected_path="$(normalize_selection "$workspace_dir" "$selected_raw")"
    if [ "$selected_path" != "$last_selection" ]; then
      last_selection="$selected_path"
      if previewable_path "$selected_path"; then
        TMUX_PANE="$broot_pane" "$script_root/bin/codex-open-in-vim" --preview "$selected_path" </dev/null >/dev/null 2>&1 || true
      fi
    fi
  fi
  sleep "$poll_interval"
done

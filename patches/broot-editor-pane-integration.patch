diff --git a/src/editor_state.rs b/src/editor_state.rs
new file mode 100644
index 0000000..4f310a7
--- /dev/null
+++ b/src/editor_state.rs
@@ -0,0 +1,50 @@
+use {
+    rustc_hash::FxHashMap,
+    std::{
+        fs,
+        path::{
+            Path,
+            PathBuf,
+        },
+    },
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum EditorBufferState {
+    Clean,
+    Modified,
+}
+
+#[derive(Debug, Clone, Default)]
+pub struct EditorStateSet {
+    states: FxHashMap<PathBuf, EditorBufferState>,
+}
+
+impl EditorStateSet {
+    pub fn from_file(path: &Path) -> Option<Self> {
+        let raw = fs::read_to_string(path).ok()?;
+        let mut states = FxHashMap::default();
+        for line in raw.lines() {
+            let Some((state, path)) = line.split_once('\t') else {
+                continue;
+            };
+            let state = match state {
+                "0" => EditorBufferState::Clean,
+                "1" => EditorBufferState::Modified,
+                _ => continue,
+            };
+            if path.is_empty() {
+                continue;
+            }
+            states.insert(PathBuf::from(path), state);
+        }
+        Some(Self { states })
+    }
+
+    pub fn state(
+        &self,
+        path: &Path,
+    ) -> Option<EditorBufferState> {
+        self.states.get(path).copied()
+    }
+}

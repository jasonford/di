+#[cfg(test)]
+mod tests {
+    use {
+        super::*,
+        crate::{
+            git::LineGitStatus,
+            task_sync::ComputationResult,
+            tree::TreeOptions,
+            tree_build::BuildReport,
+        },
+        std::fs,
+    };
+
+    #[test]
+    fn pruning_lines_keep_git_marker_display() {
+        let tmp_dir = tempfile::tempdir().unwrap();
+        let root_path = tmp_dir.path().to_path_buf();
+        let child_path = root_path.join("tracked.txt");
+        fs::write(&child_path, "a\n").unwrap();
+
+        let tree = Tree {
+            lines: vec![
+                test_line(&root_path, 0, None, TreeLineType::Dir, None),
+                test_line(
+                    &child_path,
+                    1,
+                    Some(0),
+                    TreeLineType::Pruning,
+                    Some(LineGitStatus {
+                        status: Some(Status::WT_MODIFIED),
+                        diff_stats: None,
+                    }),
+                ),
+            ],
+            next_line_id: 2,
+            selection: 0,
+            options: TreeOptions::default(),
+            scroll: 0,
+            total_search: false,
+            git_status: ComputationResult::None,
+            build_report: BuildReport::default(),
+        };
+        let skin = StyleMap::no_term();
+        let ext_colors = ExtColorMap::default();
+        let displayable_tree = DisplayableTree::out_of_app(&tree, &skin, &ext_colors, 80, 3);
+
+        let (_, git_char) = displayable_tree.line_git_status_display(&tree.lines[1]);
+
+        assert_eq!(git_char, 'M');
+    }
+
+    fn test_line(
+        path: &std::path::Path,
+        id: usize,
+        parent_id: Option<usize>,
+        line_type: TreeLineType,
+        git_status: Option<LineGitStatus>,
+    ) -> TreeLine {
+        let metadata = fs::symlink_metadata(path).unwrap();
+        TreeLine {
+            id,
+            parent_id,
+            left_branches: vec![false; parent_id.map_or(0, |_| 1)].into_boxed_slice(),
+            depth: parent_id.map_or(0, |_| 1),
+            path: path.to_path_buf(),
+            subpath: path
+                .file_name()
+                .map(|name| name.to_string_lossy().into_owned())
+                .unwrap_or_else(|| path.to_string_lossy().into_owned()),
+            icon: None,
+            name: path
+                .file_name()
+                .map(|name| name.to_string_lossy().into_owned())
+                .unwrap_or_else(|| path.to_string_lossy().into_owned()),
+            line_type,
+            has_error: false,
+            nb_kept_children: 0,
+            unlisted: 0,
+            score: 0,
+            direct_match: false,
+            sum: None,
+            metadata,
+            git_status,
+            unlisted_git_status: None,
+            context_mark: None,
+        }
+    }
+}

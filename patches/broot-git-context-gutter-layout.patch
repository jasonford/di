+    fn write_root_branch<W: Write>(
+        &self,
+        cw: &mut CropWriter<W>,
+        selected: bool,
+    ) -> Result<(), ProgramError> {
+        let ComputationResult::Done(git_status) = &self.tree.git_status else {
+            return Ok(());
+        };
+        let Some(branch) = &git_status.current_branch_name else {
+            return Ok(());
+        };
+        let branch_width = branch.chars().count();
+        if branch_width >= cw.allowed {
+            return Ok(());
+        }
+        let wide_prefix = branch_width + 3 < cw.allowed;
+        cond_bg!(branch_style, self, selected, self.skin.git_branch);
+        if wide_prefix {
+            cw.queue_str(branch_style, " ᚜ ")?;
+        } else {
+            cw.queue_char(branch_style, ' ')?;
+        }
+        cw.queue_str(branch_style, branch)?;
+        if !cw.is_full() {
+            cw.queue_char(branch_style, ' ')?;
+        }
+        Ok(())
+    }

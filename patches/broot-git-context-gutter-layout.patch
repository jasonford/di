+
+    #[test]
+    fn pruning_lines_keep_git_marker_display() {
+        let tmp_dir = tempfile::tempdir().unwrap();
+        let root_path = tmp_dir.path().to_path_buf();
+        let child_path = root_path.join("tracked.txt");
+        fs::write(&child_path, "a\n").unwrap();
+
+        let tree = Tree {
+            lines: vec![
+                test_line(&root_path, 0, None, TreeLineType::Dir, None, None),
+                test_line(
+                    &child_path,
+                    1,
+                    Some(0),
+                    TreeLineType::Pruning,
+                    Some(LineGitStatus {
+                        status: Some(Status::WT_MODIFIED),
+                        diff_stats: None,
+                    }),
+                    None,
+                ),
+            ],
+            next_line_id: 2,
+            selection: 0,
+            options: TreeOptions::default(),
+            scroll: 0,
+            total_search: false,
+            git_status: ComputationResult::None,
+            build_report: BuildReport::default(),
+        };
+        let skin = StyleMap::no_term();
+        let ext_colors = ExtColorMap::default();
+        let displayable_tree = DisplayableTree::out_of_app(&tree, &skin, &ext_colors, 80, 3);
+
+        let (_, git_char) = displayable_tree.line_git_status_display(&tree.lines[1]);
+
+        assert_eq!(git_char, 'M');
+    }
+

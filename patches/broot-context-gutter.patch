@@ -0,0 +1,16 @@
+use crate::editor_state::EditorBufferState;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ContextGutterMark {
+    EditorClean,
+    EditorModified,
+}
+
+impl ContextGutterMark {
+    pub fn from_editor_state(state: EditorBufferState) -> Self {
+        match state {
+            EditorBufferState::Clean => Self::EditorClean,
+            EditorBufferState::Modified => Self::EditorModified,
+        }
+    }
+}

default_flags: "-g"

show_selection_mark: true

lines_before_match_in_preview: 1
lines_after_match_in_preview: 1

preview_transformers: [
    {
        input_extensions: [
            c
            cc
            cpp
            cxx
            h
            hh
            hpp
            cs
            go
            java
            js
            jsx
            json
            jsonc
            kt
            kts
            log
            lua
            md
            mdx
            php
            py
            rb
            rs
            scss
            sh
            sql
            swift
            toml
            ts
            tsx
            txt
            vim
            xml
            yaml
            yml
            zsh
        ]
        output_extension: "txt"
        mode: text
        command: [
            "/workspace/bin/broot-preview"
            "{input-path}"
        ]
    }
]

imports: [
    "verbs.hjson"
]

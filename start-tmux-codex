#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKDIR="${WORKDIR:-$SCRIPT_ROOT}"
default_repo_name="$(basename -- "$WORKDIR")"
case "$default_repo_name" in
  ""|/|.)
    default_repo_name="workspace"
    ;;
esac
REPO_NAME="${CODEX_REPO_NAME:-$default_repo_name}"
SESSION_NAME="${CODEX_TMUX_SESSION:-dint-$REPO_NAME}"
MODEL="${MODEL:-gpt-5.4}"
TMUX_CONFIG="${TMUX_CONFIG:-$SCRIPT_ROOT/.tmux/tmux.conf}"
CODEX_NO_ALT_SCREEN="${CODEX_NO_ALT_SCREEN:-1}"

session_slug="$(printf '%s' "$SESSION_NAME" | tr -c 'A-Za-z0-9._-' '_')"
runtime_dir="/tmp/codex-broot-$session_slug"
selection_output="$runtime_dir/selection.txt"
editor_state_file="$runtime_dir/editor-state.tsv"

tmux_cmd=(tmux -u -f "$TMUX_CONFIG")

codex_cmd=(
  codex
  --model "$MODEL"
  --dangerously-bypass-approvals-and-sandbox
)
terminal_cmd=(
  "$SCRIPT_ROOT/bin/codex-terminal-shell"
)

if [ "$CODEX_NO_ALT_SCREEN" != "0" ]; then
  codex_cmd+=(--no-alt-screen)
fi

if [ "$#" -gt 0 ]; then
  codex_cmd+=("$@")
fi

broot_cmd=(
  env
  HOME="$runtime_dir/home"
  BR_INSTALL=no
  XDG_CONFIG_HOME="$runtime_dir/xdg-config"
  CODEX_BROOT_OPEN_SCRIPT="$SCRIPT_ROOT/bin/codex-focus-terminal"
  broot
  --selection-output "$selection_output"
  --editor-state-file "$editor_state_file"
  -g
  --confine-root
  "$WORKDIR"
  --cmd ":toggle_watch"
)

if ! "${tmux_cmd[@]}" has-session -t "$SESSION_NAME" 2>/dev/null; then
  mkdir -p "$runtime_dir"
  mkdir -p "$runtime_dir/home" "$runtime_dir/xdg-config"
  : > "$selection_output"
  : > "$editor_state_file"
  "$SCRIPT_ROOT/bin/codex-prepare-broot-config" "$runtime_dir/xdg-config"
  "${tmux_cmd[@]}" new-session -d -s "$SESSION_NAME" -c "$WORKDIR" "${codex_cmd[@]}"
  window_id="$("${tmux_cmd[@]}" display-message -p -t "$SESSION_NAME:0" '#{window_id}')"
  "${tmux_cmd[@]}" rename-window -t "$window_id" "$REPO_NAME"
  codex_pane="$("${tmux_cmd[@]}" display-message -p -t "$window_id" '#{pane_id}')"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" remain-on-exit on
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_runtime_dir "$runtime_dir"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_workspace_dir "$WORKDIR"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_selection_output "$selection_output"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @codex_repo_name "$REPO_NAME"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @codex_window_id "$window_id"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @codex_pane_id "$codex_pane"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_editor_state_file "$editor_state_file"
  broot_pane="$("${tmux_cmd[@]}" split-window -h -b -P -F '#{pane_id}' -t "$window_id" -c "$WORKDIR" "${broot_cmd[@]}")"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_pane_id "$broot_pane"
  terminal_pane="$("${tmux_cmd[@]}" split-window -h -b -P -F '#{pane_id}' -t "$codex_pane" -c "$WORKDIR" "${terminal_cmd[@]}")"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @codex_terminal_pane_id "$terminal_pane"
  "$SCRIPT_ROOT/bin/codex-layout" three-column "$SESSION_NAME"
  "${tmux_cmd[@]}" select-pane -t "$codex_pane"
fi

printf -v layout_hook_cmd '%q %q %q' "$SCRIPT_ROOT/bin/codex-layout" "three-column" "$SESSION_NAME"
"${tmux_cmd[@]}" set-hook -t "$SESSION_NAME" client-attached "run-shell \"$layout_hook_cmd\""
"${tmux_cmd[@]}" set-hook -t "$SESSION_NAME" client-resized "run-shell \"$layout_hook_cmd\""
"$SCRIPT_ROOT/bin/codex-layout" three-column "$SESSION_NAME" >/dev/null 2>&1 || true

"${tmux_cmd[@]}" source-file "$TMUX_CONFIG"
exec "${tmux_cmd[@]}" attach-session -t "$SESSION_NAME"

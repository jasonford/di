#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SESSION_NAME="${CODEX_TMUX_SESSION:-codex}"
WORKDIR="${WORKDIR:-$SCRIPT_ROOT}"
MODEL="${MODEL:-gpt-5.4}"
TMUX_CONFIG="${TMUX_CONFIG:-$SCRIPT_ROOT/.tmux/tmux.conf}"
BROOT_PANE_WIDTH="${BROOT_PANE_WIDTH:-45}"
BROOT_PREVIEW_PANE_PERCENT="${BROOT_PREVIEW_PANE_PERCENT:-35}"
CODEX_NO_ALT_SCREEN="${CODEX_NO_ALT_SCREEN:-1}"

if ! [[ "$BROOT_PREVIEW_PANE_PERCENT" =~ ^[0-9]+$ ]] || [ "$BROOT_PREVIEW_PANE_PERCENT" -le 0 ] || [ "$BROOT_PREVIEW_PANE_PERCENT" -ge 100 ]; then
  BROOT_PREVIEW_PANE_PERCENT=35
fi

session_slug="$(printf '%s' "$SESSION_NAME" | tr -c 'A-Za-z0-9._-' '_')"
runtime_dir="/tmp/codex-broot-$session_slug"
selection_output="$runtime_dir/selection.txt"

tmux_cmd=(tmux -u -f "$TMUX_CONFIG")

codex_cmd=(
  codex
  --model "$MODEL"
  --dangerously-bypass-approvals-and-sandbox
)

if [ "$CODEX_NO_ALT_SCREEN" != "0" ]; then
  codex_cmd+=(--no-alt-screen)
fi

if [ "$#" -gt 0 ]; then
  codex_cmd+=("$@")
fi

broot_cmd=(
  env
  BR_INSTALL=no
  BROOT_SELECTION_OUTPUT="$selection_output"
  "$SCRIPT_ROOT/bin/broot-in-proot"
  "$WORKDIR"
)

preview_cmd=(
  bash
  "$SCRIPT_ROOT/bin/broot-preview-pane"
  "$selection_output"
)

if ! "${tmux_cmd[@]}" has-session -t "$SESSION_NAME" 2>/dev/null; then
  mkdir -p "$runtime_dir"
  : > "$selection_output"
  "${tmux_cmd[@]}" new-session -d -s "$SESSION_NAME" -c "$WORKDIR" "${codex_cmd[@]}"
  "${tmux_cmd[@]}" rename-window -t "$SESSION_NAME:0" workspace
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" remain-on-exit on
  broot_pane="$("${tmux_cmd[@]}" split-window -h -P -F '#{pane_id}' -t "$SESSION_NAME:workspace.0" -c "$WORKDIR" "${broot_cmd[@]}")"
  "${tmux_cmd[@]}" resize-pane -t "$broot_pane" -x "$BROOT_PANE_WIDTH" 2>/dev/null || true
  preview_pane="$("${tmux_cmd[@]}" split-window -v -P -F '#{pane_id}' -p "$BROOT_PREVIEW_PANE_PERCENT" -t "$broot_pane" -c "$WORKDIR" "${preview_cmd[@]}")"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_pane_id "$broot_pane"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_preview_pane_id "$preview_pane"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_runtime_dir "$runtime_dir"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_selection_output "$selection_output"
  "${tmux_cmd[@]}" select-pane -t "$SESSION_NAME:workspace.0"
fi

"${tmux_cmd[@]}" source-file "$TMUX_CONFIG"
exec "${tmux_cmd[@]}" attach-session -t "$SESSION_NAME"

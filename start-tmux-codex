#!/usr/bin/env bash
set -euo pipefail

SESSION_NAME="${CODEX_TMUX_SESSION:-codex}"
WORKDIR="${WORKDIR:-/workspace}"
MODEL="${MODEL:-gpt-5.4}"
TMUX_CONFIG="${TMUX_CONFIG:-/workspace/.tmux/tmux.conf}"
YAZI_CONFIG_HOME_DEFAULT="${YAZI_CONFIG_HOME_DEFAULT:-/opt/nvim-config/yazi}"
YAZI_CONFIG_HOME_ICONS="${YAZI_CONFIG_HOME_ICONS:-/opt/nvim-config/yazi-icons}"

tmux_cmd=(tmux -u -f "$TMUX_CONFIG")

yazi_cmd=(yazi)
if [ "${YAZI_ICONS:-0}" = "1" ]; then
  yazi_cmd=(env "YAZI_CONFIG_HOME=$YAZI_CONFIG_HOME_ICONS" yazi)
else
  yazi_cmd=(env "YAZI_CONFIG_HOME=$YAZI_CONFIG_HOME_DEFAULT" yazi)
fi

codex_cmd=(
  codex
  --model "$MODEL"
  --dangerously-bypass-approvals-and-sandbox
)

if [ "$#" -gt 0 ]; then
  codex_cmd+=("$@")
fi

if ! "${tmux_cmd[@]}" has-session -t "$SESSION_NAME" 2>/dev/null; then
  "${tmux_cmd[@]}" new-session -d -s "$SESSION_NAME" -c "$WORKDIR" "${codex_cmd[@]}"
  "${tmux_cmd[@]}" rename-window -t "$SESSION_NAME:0" workspace
  "${tmux_cmd[@]}" split-window -h -t "$SESSION_NAME:0" -c "$WORKDIR" "${yazi_cmd[@]}"
  "${tmux_cmd[@]}" select-pane -t "$SESSION_NAME:0.0"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" remain-on-exit on
fi

"${tmux_cmd[@]}" source-file "$TMUX_CONFIG"
exec "${tmux_cmd[@]}" attach-session -t "$SESSION_NAME"

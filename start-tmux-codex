#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SESSION_NAME="${CODEX_TMUX_SESSION:-codex}"
WORKDIR="${WORKDIR:-$SCRIPT_ROOT}"
MODEL="${MODEL:-gpt-5.4}"
TMUX_CONFIG="${TMUX_CONFIG:-$SCRIPT_ROOT/.tmux/tmux.conf}"
BROOT_PREVIEW_PANE_PERCENT="${BROOT_PREVIEW_PANE_PERCENT:-35}"
BROOT_PREVIEW_DIFF_MODE="${BROOT_PREVIEW_DIFF_MODE:-auto}"
CODEX_NO_ALT_SCREEN="${CODEX_NO_ALT_SCREEN:-1}"

if ! [[ "$BROOT_PREVIEW_PANE_PERCENT" =~ ^[0-9]+$ ]] || [ "$BROOT_PREVIEW_PANE_PERCENT" -le 0 ] || [ "$BROOT_PREVIEW_PANE_PERCENT" -ge 100 ]; then
  BROOT_PREVIEW_PANE_PERCENT=35
fi

case "$BROOT_PREVIEW_DIFF_MODE" in
  auto|unstaged|staged) ;;
  *)
    BROOT_PREVIEW_DIFF_MODE=auto
    ;;
esac

session_slug="$(printf '%s' "$SESSION_NAME" | tr -c 'A-Za-z0-9._-' '_')"
runtime_dir="/tmp/codex-broot-$session_slug"
selection_output="$runtime_dir/selection.txt"
editor_state_file="$runtime_dir/editor-state.tsv"
editor_socket="$runtime_dir/nvim.sock"

tmux_cmd=(tmux -u -f "$TMUX_CONFIG")

codex_cmd=(
  codex
  --model "$MODEL"
  --dangerously-bypass-approvals-and-sandbox
)

if [ "$CODEX_NO_ALT_SCREEN" != "0" ]; then
  codex_cmd+=(--no-alt-screen)
fi

if [ "$#" -gt 0 ]; then
  codex_cmd+=("$@")
fi

broot_cmd=(
  env
  HOME="$runtime_dir/home"
  BR_INSTALL=no
  XDG_CONFIG_HOME="$runtime_dir/xdg-config"
  CODEX_BROOT_OPEN_SCRIPT="$SCRIPT_ROOT/bin/codex-open-in-vim"
  broot
  --selection-output "$selection_output"
  --editor-state-file "$editor_state_file"
  -g
  --confine-root
  "$WORKDIR"
  --cmd ":toggle_watch"
)

preview_env=()
for preview_var in \
  BROOT_PREVIEW_POLL_INTERVAL \
  BROOT_PREVIEW_MAX_TEXT_LINES \
  BROOT_PREVIEW_MAX_DIFF_LINES \
  BROOT_PREVIEW_MAX_LIST_LINES \
  BROOT_PREVIEW_MAX_HEX_LINES \
  BROOT_PREVIEW_MAX_GIT_STATUS_LINES \
  BROOT_PREVIEW_HUGE_FILE_BYTES \
  BROOT_PREVIEW_MAX_HEX_BYTES
do
  if [ -n "${!preview_var+x}" ]; then
    preview_env+=("${preview_var}=${!preview_var}")
  fi
done

if ! "${tmux_cmd[@]}" has-session -t "$SESSION_NAME" 2>/dev/null; then
  mkdir -p "$runtime_dir"
  mkdir -p "$runtime_dir/home" "$runtime_dir/xdg-config"
  : > "$selection_output"
  : > "$editor_state_file"
  rm -f "$editor_socket"
  "$SCRIPT_ROOT/bin/codex-prepare-broot-config" "$runtime_dir/xdg-config"
  "${tmux_cmd[@]}" new-session -d -s "$SESSION_NAME" -c "$WORKDIR" "${codex_cmd[@]}"
  "${tmux_cmd[@]}" rename-window -t "$SESSION_NAME:0" workspace
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" remain-on-exit on
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_runtime_dir "$runtime_dir"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_workspace_dir "$WORKDIR"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_preview_diff_mode "$BROOT_PREVIEW_DIFF_MODE"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_selection_output "$selection_output"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @codex_pane_id "$("${tmux_cmd[@]}" display-message -p -t "$SESSION_NAME:workspace.0" '#{pane_id}')"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @codex_nvim_socket "$editor_socket"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @codex_nvim_state_file "$editor_state_file"
  broot_pane="$("${tmux_cmd[@]}" split-window -h -P -F '#{pane_id}' -t "$SESSION_NAME:workspace.0" -c "$WORKDIR" "${broot_cmd[@]}")"
  preview_pane="$("${tmux_cmd[@]}" split-window -v -P -F '#{pane_id}' -p "$BROOT_PREVIEW_PANE_PERCENT" -t "$broot_pane" -c "$WORKDIR" 'tail -f /dev/null')"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_pane_id "$broot_pane"
  "${tmux_cmd[@]}" set-option -t "$SESSION_NAME" @broot_preview_pane_id "$preview_pane"
  preview_watch_cmd=(
    env
    "${preview_env[@]}"
    bash
    "$SCRIPT_ROOT/bin/broot-preview-pane"
    --watch-selection "$selection_output"
    --target-pane "$preview_pane"
    --base-dir "$WORKDIR"
    --diff-mode "$BROOT_PREVIEW_DIFF_MODE"
  )
  printf -v preview_watch_shell '%q ' "${preview_watch_cmd[@]}"
  "${tmux_cmd[@]}" run-shell -b "$preview_watch_shell"
  "$SCRIPT_ROOT/bin/codex-layout" two-column "$SESSION_NAME"
  "${tmux_cmd[@]}" select-pane -t "$SESSION_NAME:workspace.0"
fi

"${tmux_cmd[@]}" source-file "$TMUX_CONFIG"
exec "${tmux_cmd[@]}" attach-session -t "$SESSION_NAME"
